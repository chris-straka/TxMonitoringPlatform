{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TxMonitoringDb": "Host=localhost;Port=5432;Database=tx_monitoring;Username=admin;Password=password"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "GroupId": "detection-group",
    "EventsTopic": "transaction-events",
    "AlertsTopic": "risk-alerts",
    "DeadLetterTopic": "transaction-events-dlq",
    "ReadinessTimeoutSeconds": 3
  },
  "OTel": {
    "ServiceName": "TxMonitoring.Detection.Worker",
    "Endpoint": "http://localhost:4317"
  },
  "Consumer": {
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30
  },
  "Outbox": {
    "IdleDelayMs": 500,
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30,
    "PublishedRetentionHours": 168,
    "MaintenanceIntervalSeconds": 30
  }
}
