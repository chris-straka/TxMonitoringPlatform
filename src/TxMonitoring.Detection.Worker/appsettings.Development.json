{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TxMonitoringDb": "Host=localhost;Port=5432;Database=tx_monitoring;Username=admin;Password=password"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "GroupId": "detection-group",
    "EventsTopic": "transaction-events",
    "AlertsTopic": "risk-alerts",
    "DeadLetterTopic": "transaction-events-dlq",
    "ReadinessTimeoutSeconds": 3
  },
  "OTel": {
    "ServiceName": "TxMonitoring.Detection.Worker",
    "Endpoint": "http://localhost:4317"
  },
  "Consumer": {
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30
  },
  "Outbox": {
    "IdleDelayMs": 500,
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30,
    "PublishedRetentionHours": 168,
    "MaintenanceIntervalSeconds": 30
  },
  "Velocity": {
    "Configuration": "localhost:6379",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "KeyTtlSeconds": 3900,
    "LazyRebuildLimit": 1000,
    "WarmRebuildPageSize": 500,
    "RebuildMarkMs": 500
  },
  "RiskPolicy": {
    "PolicyVersion": "risk-policy-v1",
    "ReviewThreshold": 60,
    "AmountFamilyCap": 70,
    "VelocityFamilyCap": 70,
    "RulesByCurrency": {
      "CAD": {
        "AbsoluteHighAmount": 250000,
        "AbsoluteHighPoints": 35,
        "AccountSpikePoints": 40,
        "Count1mThreshold": 20,
        "Count1mPoints": 40,
        "Amount5mThreshold": 1000000,
        "Amount5mPoints": 40
      }
    }
  }
}
